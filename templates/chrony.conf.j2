{{ ansible_managed | comment }}
# Ubuntu 26.04: chrony is the default time daemon (systemd-timesyncd is no longer installed on
# new systems). The distro ships NTS-enabled Ubuntu pools in /etc/chrony/sources.d/.

# Drop-in configuration (keep so packages/admins can extend without editing this file)
confdir /etc/chrony/conf.d

{% if cis_ubuntu2604_rule_2_3_3_1 is defined and cis_ubuntu2604_rule_2_3_3_1 %}
# CIS 2.3.3.1 | authorized time servers
{% for server in cis_ubuntu2604_time_synchronization_time_server %}
{% if server.uri is defined %}
{{ server.type | default('server') }} {{ server.uri }} {{ server.config | default("iburst") }}
{% endif %}
{% endfor %}
{% endif %}

{% if cis_ubuntu2604_chrony_use_distro_sources | bool %}
# Keep Ubuntu-shipped sources (NTS pools) in addition to the servers above
sourcedir /etc/chrony/sources.d
{% endif %}
{% if cis_ubuntu2604_chrony_use_dhcp_sources | bool %}
sourcedir /run/chrony-dhcp
{% endif %}

{% if cis_ubuntu2604_rule_2_3_3_2 is defined and cis_ubuntu2604_rule_2_3_3_2 %}
# CIS 2.3.3.2 | Ensure chrony is running as user _chrony
user _chrony
{% endif %}

keyfile /etc/chrony/chrony.keys
driftfile /var/lib/chrony/chrony.drift
ntsdumpdir /var/lib/chrony

log tracking measurements statistics
logdir /var/log/chrony

maxupdateskew 100.0
rtcsync
makestep 1 3
maxdistance 1
leapsecmode slew
